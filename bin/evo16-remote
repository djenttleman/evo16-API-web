#!/bin/bash
# Adapter for the app-owned lifecycle. Uses only tools shipped with macOS.
set -euo pipefail
DATA="$HOME/Library/Application Support/EVO16Remote"
APP="${EVO16_APP_PATH:-$HOME/Applications/EVO 16 Remote.app}"
STATE="$DATA/estado.json"
LOG="$HOME/Library/Logs/evo16-remote.log"
ACTION="${1:-status}"

command_app() { open -g -a "$APP" "evo16remote://$1"; }
state_is_fresh() {
    [ -f "$STATE" ] || return 1
    local modified
    modified="$(stat -f %m "$STATE")"
    [ "$(( $(date +%s) - modified ))" -le 8 ]
}
api() {
    [ -r "$DATA/api-token" ] || { echo 'La app todavía no creó la credencial API.' >&2; return 1; }
    local token
    token="$(cat "$DATA/api-token")"
    printf 'Authorization: Bearer %s\n' "$token" | curl --silent --show-error --fail --max-time 6 \
        --header @- "http://127.0.0.1:3000/api/$1"
    echo
}
case "$ACTION" in
    start|on|stop|off|preferences)
        case "$ACTION" in on) ACTION=start ;; off) ACTION=stop ;; esac
        command_app "$ACTION"
        printf '{"accepted":true,"action":"%s"}\n' "$ACTION"
        ;;
    restart)
        command_app stop
        stopped=0
        for _ in {1..40}; do
            sleep 0.2
            if state_is_fresh && [ "$(plutil -extract state raw -o - "$STATE")" = offline ]; then stopped=1; break; fi
        done
        [ "$stopped" -eq 1 ] || { echo 'El servicio no se detuvo; no se envió start.' >&2; exit 1; }
        command_app start
        ;;
    status)
        if state_is_fresh; then cat "$STATE"; echo
        else printf '{"state":"offline","ok":false,"stateDetail":"La app no responde o el estado venció"}\n'; fi
        ;;
    health|info) api "$ACTION" ;;
    url) echo 'http://127.0.0.1:3000' ;;
    logs) tail -n 80 "$LOG" ;;
    install|launcher-install)
        echo 'Los agentes launchd y el launcher separado están deprecados. Usa menubar/install.command.' >&2
        exit 1 ;;
    *) echo 'Uso: evo16-remote start|stop|restart|status|health|info|url|logs|preferences' >&2; exit 1 ;;
esac
