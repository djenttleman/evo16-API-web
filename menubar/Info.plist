<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>EVO 16 Remote</string>
    <key>CFBundleDisplayName</key>
    <string>EVO 16 Remote</string>
    <key>CFBundleIdentifier</key>
    <string>app.local.evo16-remote-menubar</string>
    <key>CFBundleExecutable</key>
    <string>EVO16RemoteApp</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Sin ícono en el Dock: sólo barra de menú -->
    <key>LSUIElement</key>
    <true/>

    <!-- Otras apps pueden pedir encendido/apagado así:
             open -g "evo16remote://start"   (también stop / status)
         No se expone ningún endpoint HTTP propio: el único canal es este. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>app.local.evo16-remote-menubar.url</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>evo16remote</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
